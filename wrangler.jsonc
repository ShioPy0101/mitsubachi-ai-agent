{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mitsubachi-ai-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mitsubachi-ai-agent",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "AUDIO_JOBS", "queue": "mitsubachi-audio-jobs" }
    ],
    "consumers": [
      {
        "queue": "mitsubachi-audio-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "mitsubachi-audio-jobs-dlq"
      }
    ]
  },
  "vars": {
    "MAX_AUDIO_BYTES": "26214400",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "GUARDRAILS_GATEWAY_ID": "mitsubachi-guardrails"
  }
}
