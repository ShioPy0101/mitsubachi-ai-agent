{
  "name": "mitsubachi-ai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts && vitest run",
    "test:watch": "vitest",
    "discord:register": "node --env-file-if-exists=.dev.vars --import tsx scripts/register-discord-commands.ts",
    "generate:railway-data": "node --import tsx scripts/generate-railway-data.ts",
    "benchmark:stations": "node --import tsx scripts/benchmark-static.ts",
    "test:station": "vitest run --config vitest.unit.config.ts",
    "eval:station": "node --import tsx scripts/eval-station.ts",
    "eval:railway": "node --import tsx scripts/eval-station.ts fixtures/railway",
    "db:migrate:local": "wrangler d1 migrations apply mitsubachi-ai-agent --local",
    "verify:local": "node --import tsx scripts/verify-local.ts",
    "eval:whisper": "node --env-file-if-exists=.dev.vars --import tsx scripts/eval-external-ai.ts whisper",
    "eval:gemini-analysis": "node --env-file-if-exists=.dev.vars --import tsx scripts/eval-external-ai.ts analysis",
    "eval:normalize": "node --env-file-if-exists=.dev.vars --import tsx scripts/eval-external-ai.ts normalize",
    "eval:full": "node --env-file-if-exists=.dev.vars --import tsx scripts/eval-external-ai.ts full",
    "eval:accuracy": "node --import tsx scripts/eval-accuracy.ts",
    "benchmark:static": "node --import tsx scripts/benchmark-static.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "codec-parser": "^2.5.0",
    "hono": "^4.9.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.69",
    "@types/node": "^24.5.2",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.2"
  },
  "packageManager": "pnpm@10.17.1"
}
